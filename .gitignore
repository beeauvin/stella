# Everything is ignored unless a line below lets it through. A directory is let
# through first, then what's in it, because Git won't look inside a directory
# it ignores.
*

# The root's own files.
!/.gitignore
!/Cargo.lock
!/Cargo.toml
!/clippy.toml
!/license.md
!/mise.toml
!/readme.md
!/rustfmt.toml

# The alias that makes `cargo xtask` run the workspace's tools.
!/.cargo/
!/.cargo/**

# The workflows GitHub runs.
!/.github/
!/.github/**

# The crates.
!/blocks/
!/blocks/**
!/checks/
!/checks/**
!/cli/
!/cli/**
!/lexer/
!/lexer/**
!/linter/
!/linter/**
!/source/
!/source/**
!/test-support/
!/test-support/**
!/xtask/
!/xtask/**

# The documentation, which is also an Obsidian vault.
!/docs/
!/docs/**

# What the lines above let through, but nobody wrote.
.DS_Store
/docs/.obsidian/workspace.json
